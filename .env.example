PORT=3000
HOST=0.0.0.0
# Set to 1 only when the app is behind a trusted single reverse proxy.
TRUST_PROXY=0
# Set this to the exact deployed frontend origin, without a trailing slash.
FRONTEND_URL=http://localhost:3000
# Use a persistent writable directory on your deployment platform.
DATA_DIR=./data
LIBRARY_ADMIN_USERNAME=admin
# Use a unique password of at least 12 characters (do not use admin123).
LIBRARY_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Replace with a random secret of at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
